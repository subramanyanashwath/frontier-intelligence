# Names only. Copy to .env.local. Never commit real secrets.

# Supabase / Postgres
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Private Career Alpha gate. Required in production.
# Development default when unset: demo-operator
PRIVATE_MODE_PASSPHRASE=

# Optional integrations
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Optional future LLM extraction
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ingestion safety valves
INGEST_QUERY=artificial intelligence
INGEST_MAX_PAGES=2
INGEST_DELAY_MS=1000
INGEST_DETAIL_LIMIT=20
